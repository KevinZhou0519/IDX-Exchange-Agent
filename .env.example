# Copy to .env and fill in. Never commit .env.

# Embeddings (Week 6)
OPENAI_API_KEY=

# MySQL: the agent uses the read-only idx_user (created by `corepack pnpm setup:db`,
# local connections only, no password)
MYSQL_HOST=localhost
MYSQL_USER=idx_user
MYSQL_PASSWORD=
MYSQL_DATABASE=idx_exchange

# Email agents (Week 11). For Gmail, use an app password.
EMAIL_USER=
EMAIL_PASSWORD=
