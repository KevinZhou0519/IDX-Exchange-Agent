{
  "name": "idx-exchange-agent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.0",
  "scripts": {
    "test": "vitest run",
    "vocab": "node scripts/build-vocab.ts",
    "eval": "caffeinate -i node scripts/eval-llm.ts",
    "typecheck": "tsc -p tsconfig.json",
    "link-openclaw": "bash scripts/link-openclaw.sh",
    "postinstall": "bash scripts/link-openclaw.sh || echo \"warning: OpenClaw SDK not linked; plugin tests will fail until it is\"",
    "build:plugin": "node scripts/build-plugin.ts",
    "test:db": "vitest run --config vitest.integration.config.ts",
    "setup:db": "node scripts/setup-db.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "mysql2": "^3.24.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
